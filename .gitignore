# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build outputs ─────────────────────────────────────────────────────────────
/.next/
/out/
/build
server/dist/

# ── Environment & secrets ──────────────────────────────────────────────────────
# All .env files with real values MUST stay local — never commit these.
.env
.env.local
.env.*.local
# Keep the example templates (they contain no real secrets)
!.env.example
!server/.env.example

# ── Prisma generated client ────────────────────────────────────────────────────
/src/generated/prisma

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── TypeScript build info ─────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing ───────────────────────────────────────────────────────────────────
/coverage

# ── Misc ──────────────────────────────────────────────────────────────────────
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
