# ─────────────────────────────────────────────────────────────────────────────
# TypeRush – Socket.IO Server  /  Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (inside /server) and fill in real values.
# ❌ NEVER commit .env with real values to git.
# ─────────────────────────────────────────────────────────────────────────────

# Port the Socket.IO HTTP server listens on
PORT=4000

# Redis connection string (used for the Socket.IO Redis adapter)
# Local (docker-compose):  redis://localhost:6379
# Production (Upstash / Redis Cloud / Railway):  rediss://default:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379

# Full public URL of the Next.js app (used to fetch passages & set CORS origin)
# Local:       http://localhost:3000
# Production:  https://your-domain.com
CLIENT_URL=http://localhost:3000
