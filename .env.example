# ─────────────────────────────────────────────────────────────────────────────
# TypeRush – Next.js App  /  Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local dev, or paste the values into your
# hosting provider's dashboard (Vercel / Railway / Render / etc.).
#
# ❌ NEVER commit .env or .env.local with real values to git.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/typingrace?sslmode=require

NEXTAUTH_SECRET=replace_with_a_random_32_char_secret

NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
