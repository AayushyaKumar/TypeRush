# ─────────────────────────────────────────────────────────────────────────────
# TypeRush – Next.js App  /  Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local dev, or paste the values into your
# hosting provider's dashboard (Vercel / Railway / Render / etc.).
#
# ❌ NEVER commit .env or .env.local with real values to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local dev (docker-compose):  postgresql://aayushya:your_password@localhost:5432/typingrace
# Production:  obtain from Neon / Supabase / Railway / PlanetScale, etc.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/typingrace?sslmode=require

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Random secret used to sign JWTs / session tokens.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_random_32_char_secret

# Full public URL of this Next.js app (no trailing slash).
# Local:       http://localhost:3000
# Production:  https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must include:  <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Socket.IO server (client-side, must start with NEXT_PUBLIC_) ──────────────
# Local:       http://localhost:4000
# Production:  https://your-socket-server.com  (or wss:// if TLS-terminated upstream)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
